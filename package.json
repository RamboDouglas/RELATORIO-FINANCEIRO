{
    "name": "relatorio-financeiro",
    "version": "1.0.0",
    "description": "Painel financeiro mensal para loja de conveniência, em HTML, CSS e JavaScript puros.",
    "private": true,
    "type": "commonjs",
    "scripts": {
        "build:css": "tailwindcss -i src/tailwind.css -o css/tailwind.css --minify",
        "watch:css": "tailwindcss -i src/tailwind.css -o css/tailwind.css --watch",
        "lint": "eslint js tests --ext .js,.mjs",
        "format": "prettier --write \"{js,tests}/**/*.{js,mjs}\" \"*.{json,md}\"",
        "format:check": "prettier --check \"{js,tests}/**/*.{js,mjs}\"",
        "test:unit": "node --test tests/core.test.mjs",
        "test:ui": "node tests/ui.test.mjs",
        "test": "npm run test:unit && npm run test:ui",
        "serve": "node tests/servidor.mjs"
    },
    "devDependencies": {
        "@fortawesome/fontawesome-free": "^6.7.2",
        "chart.js": "^4.4.7",
        "chartjs-plugin-datalabels": "^2.2.0",
        "eslint": "^8.57.1",
        "html2canvas": "^1.4.1",
        "jspdf": "^2.5.2",
        "playwright": "^1.49.0",
        "prettier": "^3.4.2",
        "tailwindcss": "^3.4.17"
    }
}
